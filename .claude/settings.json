{
  "claudeMdExcludes": [
    "**/canvas/spec/CLAUDE.md",
    "**/canvas/spec/**/CLAUDE.md"
  ],
  "autoCompactWindow": 400000,
  "disableClaudeAiConnectors": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/spec/tools/session/main.mjs"]
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(/samples)",
      "Read(/samples/**)",
      "Edit(/samples)",
      "Edit(/samples/**)",
      "Bash(samples)",
      "Bash(samples *)",
      "Bash(samples/*)",
      "Bash(* samples)",
      "Bash(* samples *)",
      "Bash(* samples/*)",
      "Bash(*/samples)",
      "Bash(*/samples *)",
      "Bash(*/samples/*)",
      "Bash(*\"samples\"*)",
      "Bash(*\"samples/*)",
      "Bash(*'samples'*)",
      "Bash(*'samples/*)",
      "Bash(*=samples)",
      "Bash(*=samples *)",
      "Bash(*=samples/*)",
      "Bash(*<samples*)",
      "Bash(*>samples*)"
    ]
  }
}
