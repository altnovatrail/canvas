# The samples of the samples page and the device checks: handwriting, with the time and pressure of
# every stroke. They stay out of git, and no agent opens them, as CLAUDE.md and
# .claude/settings.json hold.
/samples/

# What npm ci installs from package-lock.json.
/node_modules/
# The package's build: just build writes it, npm pack takes it.
/lib/
# What tsc -b leaves beside the programs of the root tsconfig.json, should anyone run it.
*.tsbuildinfo
# The release's files: only release-files writes them.
/dist/
# The generator of the synthetic samples as tsc builds it, and the set it writes: just synthetic
# and ci-licenses. And the files of the probe of a page opened from a file, which
# node probe/build.ts build/probe writes for a pre-release.
/build/
# The coverage of the tests: ci-test writes it, and Vitest clears it before each run.
/coverage/
# The screenshots Vitest takes of a failed test in the browser: Vitest 5 puts them under .vitest/.
__screenshots__/
/.vitest/
