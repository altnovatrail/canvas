{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "probe/**/*.ts",
    "emulators/**/*.ts",
    "src/**/*.test.ts",
    "page/**/*.test.ts",
    "vitest.config.ts",
    "demo/vite.config.ts"
  ]
}
